# Copy to .env and adjust. Docker Compose reads this file.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=8
DEMO_MODE=true
NETTING_TIME_BUDGET_MS=2000
MAX_RECOMPUTES=2
STANDARD_RATE_BPS=52
FEE_SHARE_BPS=2500
DUST_THRESHOLD_MINOR=100
FX_LOCK_MINUTES=30
ALGO_VERSION=net-0.1.0
# Runtime role (no UPDATE/DELETE on ledger and audit tables) and migration/owner role.
# Inside Compose the host is "db"; from the host machine use localhost:5434.
DATABASE_URL=postgresql+psycopg://mesh_app:mesh_app@localhost:5434/mesh
MIGRATION_DATABASE_URL=postgresql+psycopg://mesh:mesh@localhost:5434/mesh
